# Copia este archivo como .env (no lo subas a GitHub) o define las variables en Azure.
# Sin estas dos variables la app funciona en modo demo, guardando en memoria.
COSMOS_ENDPOINT=https://<tu-cuenta>.documents.azure.com:443/
COSMOS_KEY=<clave-primaria-de-cosmos>
COSMOS_DATABASE=bitacora
COSMOS_CONTAINER=incidencias
